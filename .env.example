# EFT Buddy — production environment. Copy to `.env` and fill in.
#
#     cp .env.example .env
#
# `.env` is gitignored AND dockerignored, and the two are separate mechanisms
# that have to be maintained separately. This file carries NO real values: it is
# committed, and this repository is public.
#
# Everything here is read by config/runtime.exs at boot, not at compile time,
# which is what lets one image run against any environment. Where that file
# raises rather than defaults, it says so below — those raises are deliberate: a
# release that refuses to start beats one that starts misconfigured.
#
# FORMAT. `KEY=value`, no spaces around the `=`. `docker compose --env-file` and
# most dotenv loaders treat `KEY =value` as a key with a trailing space, which
# then silently fails to match anything the app looks up.

# ── Required ──────────────────────────────────────────────────────────────────
# Blank is not the same as unset, and runtime.exs rejects both. A line reading
# `PHX_HOST=` produces an empty string, which is truthy in Elixir and used to
# sail straight through.

# Generate with: mix phx.gen.secret
SECRET_KEY_BASE=

# The password is deliberately NOT in DATABASE_URL, so it stays out of logs,
# crash dumps and anywhere the URL might be echoed. runtime.exs applies it as an
# explicit override on top of whatever the URL parses to.
DB_PASSWORD=

# Note there is no password in this URL — see DB_PASSWORD above.
# Format: ecto://USER@HOST:PORT/DATABASE. `db` is the Postgres service name on
# the compose network, and the database listens nowhere else — there is no host
# port published for it, so this URL is only resolvable from inside the stack.
DATABASE_URL=ecto://eftbuddy@db:5432/eft_buddy_prod

# A BARE hostname: no scheme, no port, no path, no trailing slash. This value is
# compared verbatim against the Origin header for LiveView sockets, so
# `https://example.com` here rejects 100% of sockets while the page still renders
# its static HTML and /health still answers 200 — a silent, total breakage.
PHX_HOST=eftbuddy.example

# The port Bandit binds INSIDE the container. There is no default: an app that
# picks its own port when you forgot to name one comes up looking healthy and
# is simply unreachable.
#
# Keep it at 4000 here. docker-compose.yml hardcodes 4000 as the container side
# of its published mapping AND as the target of its healthcheck, so any other
# value leaves the app listening where nothing is looking for it.
PORT=4000

# ── Cloudflare Tunnel ─────────────────────────────────────────────────────────

# Read by docker-compose.yml for the `cloudflared` service, not by the app, and
# required there: `docker compose up` refuses to start without it. The token is
# the tunnel's identity and credentials in one, as sensitive as a private key —
# it alone is enough to impersonate the tunnel and receive the site's traffic.
# Copy it from the tunnel's page in the Cloudflare Zero Trust dashboard.
TUNNEL_TOKEN=

# ── Database TLS ──────────────────────────────────────────────────────────────

# Off unless set. Required for any hosted database. NOT needed for the local
# Postgres container: it is reachable only over the compose network, which never
# leaves the host, so there is no wire to protect.
DB_SSL=false

# The CA that verifies the database's certificate, replacing the OS trust store.
#
# UNUSED in the current deployment, and commented out for that reason: the
# database is a container on a private Docker network, DB_SSL is off, and
# config/runtime.exs never reads this. It is documented because the mechanism is
# generic and the day the database moves off-box is the day it is needed.
#
# Set it for a provider that runs its own PKI. Such a root is in no OS trust
# store, so `verify_peer` anchored to the system store CANNOT build a path to it
# and the handshake fails with `Fatal - Unknown CA`. Pinning is what makes
# verification possible at all there — and it is TIGHTER than the default, since
# the connection then trusts exactly one issuer instead of every public CA on the
# machine. Download the root from the provider, not off the connection you are
# trying to verify, which is circular. Nothing is baked into the image any more;
# mount the file, so rotating the root does not mean rebuilding.
#
# Verify what you downloaded matches what the server serves:
#
#   openssl x509 -in /path/to/root.crt -noout -fingerprint -sha256
#   openssl s_client -starttls postgres -showcerts -connect "$DB_HOST:5432" \
#     -servername "$DB_HOST" </dev/null 2>/dev/null \
#     | awk '/BEGIN CERT/{n++} n==3' | openssl x509 -noout -fingerprint -sha256
#
# Leave it unset for a database whose certificate a public CA signed (RDS with
# the Amazon bundle, or any server with a real cert) and the OS trust store is
# used instead.
# DB_CACERTFILE=/run/secrets/db-root-ca.crt

# DEBUG ONLY. NEVER LEAVE THIS ON.
#
# Drops the connection to `verify: :verify_none` — TLS with nothing verified,
# which protects against passive sniffing and nothing else. There is no check
# that the peer holding the certificate is the host you asked for, so anyone able
# to intercept the connection can read and rewrite every query and result.
#
# It exists to tell a certificate problem apart from a connectivity problem in a
# single restart. It is a separate variable from DB_SSL precisely so that turning
# TLS on can never quietly mean turning verification off.
#
# If you need this to connect at all, the answer is DB_CACERTFILE above.
# DB_SSL_INSECURE=true

# ── Optional ──────────────────────────────────────────────────────────────────

# Host-side publishing, read by docker-compose.yml (NOT by the app).
# The tunnel that fronts the app runs on this same host and dials outbound, so
# nothing needs to reach this port from the LAN. Leave BIND_ADDR at 127.0.0.1:
# publishing to 0.0.0.0 puts the app on the LAN with no TLS in front of it.
APP_PORT=4000
BIND_ADDR=127.0.0.1

# ── Operator endpoint ─────────────────────────────────────────────────────────

# The admin endpoint, on its OWN port, published to loopback only. It serves the
# detailed readiness payload (`/health/sync` with budgets, run records and cache
# state; the public `/health/sync` carries only each feed's state and age).
# LiveDashboard used to run here and is disabled; a fuller dashboard is planned.
#
# Unset (the default) means the endpoint is never started and nothing binds the
# port — fail-closed by omission, not by a flag that could be set to the wrong
# string. Set it and docker-compose.yml publishes `127.0.0.1:<port>:<port>`, so
# the page is unreachable from the LAN and the internet.
#
# To view it, forward the port over SSH from your workstation:
#
#     ssh -N -L 4001:127.0.0.1:4001 user@pi5
#     # then: curl http://localhost:4001/health/sync
#
# The tunnel's far end originates on the Pi, which is what satisfies the loopback
# binding, and opening it requires your SSH key — so the key IS the endpoint's
# access control. There is no password to set here, and deliberately so: a public
# route with basic auth can be brute forced or opened by a missing variable.
#
# Do not publish this port to anything but loopback.
# ADMIN_DASHBOARD_PORT=4001

# Ecto connection pool. Raise with care, and in step with `max_connections` on
# the server: exceeding the server's limit fails connections rather than queueing
# them. docker-compose.yml sets Postgres to 50, sized for this pool plus the
# one-shot migrate container plus a psql session.
# POOL_SIZE=10

# Connect to the database over IPv6. Needed only for a host that publishes no
# A record. The local container is reached by service name over the compose
# network and does not need this.
# ECTO_IPV6=true

# Every numeric variable below may be left unset or blank for its default; any
# other non-integer stops the boot with a message naming the variable.

# Concurrent operator sessions (each holds one visitor's HUD state and progress
# in memory). Sized to the box's memory, not its traffic: past the ceiling a new
# visitor degrades to cookie-only state, while overshooting can take the node
# down. The default (5,000) and the arithmetic behind it are in
# `EftBuddy.OperatorSessions.ceiling/0`.
# MAX_OPERATOR_SESSIONS=5000

# The read cache. On by default, and a KILL SWITCH rather than a feature flag:
# `0` (or `false`/`no`) plus a restart turns it off in seconds if it ever serves
# something wrong, without a rebuild.
# CACHE_ENABLED=1

# The cache's entry ceiling. It never evicts warmed entries to stay under this —
# it logs and overshoots instead — so a value below the warm set's size is a log
# line, not a memory bound.
# CACHE_MAX_ENTRIES=20000

# The in-memory item catalogue behind the Items and Flea Market pages. Off by
# default. On (`1`), those pages filter and paginate in ETS instead of SQL; every
# read falls back to SQL while it is building, so turning it off again is a
# restart, not a rebuild.
# ITEM_DATASET=1

# Precompute every item's detail panel after each sync. Off by default; measure
# the box's free memory before turning it on. It only changes latency: the panel
# reads the same data either way.
# ITEM_DETAILS=1

# How much the detail precompute may add to the cache, in MEGABYTES. Default 250
# (`EftBuddy.Items.details_max_bytes/0`). The over-budget log line names this.
# ITEM_DETAILS_MAX_MB=250

# Rotate the LiveView signing salt without a rebuild. Not a secret; leave unset
# for the one in config/config.exs.
# LIVE_VIEW_SIGNING_SALT=

# Clustering (DNSCluster). Leave unset: the app runs on one node, and several
# nodes would need more than this (operator sessions are node-local, and the
# sync singletons do not fail over).
# DNS_CLUSTER_QUERY=
