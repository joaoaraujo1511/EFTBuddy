# Local development settings. Copy to `.env`, then export it into your shell:
#
#     cp .env.dev.example .env
#     set -a; . ./.env; set +a
#
# These match a stock local PostgreSQL. Change them if yours differs.

PORT=4000
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_HOSTNAME=localhost
DB_NAME=eft_buddy_dev
