<Layouts.app
  flash={@flash}
  active={@active}
  pmc_level={@pmc_level}
  mode={@mode}
  faction={@faction}
  scav_karma={@scav_karma}
  page_title={@chapter.chapter_name}
  rail_collapsed={@rail_collapsed}
>
  <div class="max-w-[1800px] mx-auto px-4 sm:px-6 py-8 space-y-6">
    <.link
      navigate={~p"/storyline"}
      class="inline-flex items-center gap-1.5 t-label text-[11px] text-fog-500 hover:text-amber transition-colors"
    >
      <.icon name="hero-arrow-left" class="w-4 h-4" /> Storyline
    </.link>

    <%!-- Chapter header --%>
    <article class="hud-panel hud-notch overflow-hidden">
      <div :if={@chapter.banner} class="relative h-64 overflow-hidden border-b border-line">
        <img
          src={@chapter.banner.url}
          alt={@chapter.chapter_name}
          loading="lazy"
          class="w-full h-64 object-cover"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-ink-900/80 to-transparent"></div>
      </div>
      <div class="p-6">
        <h1 class="t-head text-3xl sm:text-4xl text-fog-50 flex items-center gap-3">
          <span
            :if={icon_src = chapter_icon_src(@chapter)}
            aria-hidden="true"
            class="w-10 h-10 shrink-0 chapter-glyph text-fog-50"
            style={"--chapter-glyph-src:url('#{icon_src}')"}
          >
          </span>
          {@chapter.chapter_name}
        </h1>

        <p :if={@chapter.summary} class="text-fog-300 leading-relaxed mt-3 max-w-3xl">
          {@chapter.summary}
        </p>

        <div class="mt-4 flex flex-wrap items-center gap-x-5 gap-y-1.5 t-label text-[10px] text-fog-400">
          <span class="inline-flex items-center gap-1.5">
            <.icon name="hero-list-bullet" class="t-label-icon w-4 h-4 text-signal" /> {@chapter.objective_count} objectives
          </span>
          <span class="inline-flex items-center gap-1.5">
            <.icon name="hero-photo" class="t-label-icon w-4 h-4 text-signal" /> {@chapter.image_count} images
          </span>
        </div>

        <div :if={@related_tasks != []} class="mt-5">
          <div class="t-label text-[9px] text-fog-500 mb-2">Related tasks</div>
          <div class="flex flex-wrap gap-2">
            <.link
              :for={task <- @related_tasks}
              navigate={~p"/tasks?#{[q: task.name]}"}
              class="inline-flex items-center px-2.5 py-1 text-xs bg-ink-900 text-fog-300 border border-line hover:border-amber hover:text-amber transition-colors"
            >
              {task.name}
            </.link>
          </div>
        </div>

        <%!-- One credit per chapter, in the header where it is visible before
             any scrolling: it covers the summary above and every walkthrough
             section below, all captured from the same wiki page. --%>
        <.source_credit
          id="credit-chapter"
          href={@chapter.wiki_link}
          contributors={@chapter.contributors}
          image_uploaders={@chapter.image_uploaders}
          class="mt-5 pt-4 border-t border-line"
        />
      </div>
    </article>

    <.tabs :if={length(@tabs) > 1} class="w-fit" active={@view} items={@tabs} />

    <%!-- WALKTHROUGH view. Full width: the old "On this page" jump-nav aside
         (and the 220px gutter it lived in) is gone, and the per-section
         "Related items" tables inside the guide cover what the removed
         chapter-level ITEMS tab used to aggregate. --%>
    <div :if={@view == "walkthrough"} class="min-w-0 space-y-6">
      <.content_section
        :for={sec <- @chapter.content_sections}
        section={sec}
        item_index={@item_index}
      />
    </div>

    <%!-- ENDINGS view --%>
    <div :if={@view == "endings" && @endings} class="space-y-6">
      <div>
        <h2 class="t-head text-2xl text-fog-100">Story endings</h2>
        <p class="text-sm text-fog-400 mt-1 max-w-3xl">
          How your decisions and completed objectives branch into the four endings - each one's
          outcome and the rewards it grants.
        </p>
      </div>
      <.content_section
        :for={sec <- @endings.content_sections}
        section={sec}
        item_index={@item_index}
      />

      <%!-- The endings are transcluded from the endgame chapter's own wiki
           page, which is not necessarily the chapter being viewed - so this
           credit points at `@endings`, not `@chapter`. --%>
      <.source_credit
        id="credit-endings"
        href={@endings.wiki_link}
        contributors={@endings.contributors}
        image_uploaders={@endings.image_uploaders}
      />
    </div>
  </div>
</Layouts.app>
